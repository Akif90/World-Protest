# Docker Compose settings. Copy to .env before deploying; .env is gitignored.
# Use a unique password on a public server. Generate with: openssl rand -hex 24
# Use hex characters so the password is safe inside DATABASE_URL without encoding.
POSTGRES_PASSWORD=wpa
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Empty means the browser uses the same host through Nginx's /api/ proxy.
VITE_API_BASE=
