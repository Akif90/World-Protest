# Copy to .env (or export these) when deploying. Every value has a development
# default, so local work needs none of them.

# Postgres connection string.
DATABASE_URL=postgresql+psycopg://wpa:wpa@localhost:5433/wpa

# Comma-separated browser origins allowed to call the API. The defaults cover
# only local dev, so this MUST be set for any real deployment or the browser
# blocks every request with a CORS error.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Article-title enrichment worker.
ENRICH_TIMEOUT_SECONDS=8
ENRICH_WORKERS=10
ENRICH_BATCH_SIZE=50

# Ingestion.
INGEST_CHUNK_ROWS=1000
BACKFILL_WORKERS=8

# Repeat opens by one viewer within this window count once toward "most read".
OPEN_DEDUP_WINDOW_HOURS=24
